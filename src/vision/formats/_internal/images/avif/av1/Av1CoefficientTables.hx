	/** Expands a packed group into tile-local CDFs with an adaptation count. **/
	public static function unpack(hex:String, symbols:Int):Array<Array<Int>> {
		final bytes = Bytes.ofHex(hex);
		final result = [];
		var position = 0;
		while (position < bytes.length) {
			final cdf = [];
			for (_ in 0...symbols - 1) {
				cdf.push((bytes.get(position) << 8) | bytes.get(position + 1));
				position += 2;
			}
			cdf.push(32768);
			cdf.push(0);
			result.push(cdf);
		}
		return result;
	}
